<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="product.dao.SpuCommentDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="product.entity.SpuCommentEntity" id="spuCommentMap">
        <result property="id" column="id"/>
        <result property="skuId" column="sku_id"/>
        <result property="spuId" column="spu_id"/>
        <result property="orderItemId" column="order_item_id"/>
        <result property="memberId" column="member_id"/>
        <result property="spuName" column="spu_name"/>
        <result property="memberNickName" column="member_nick_name"/>
        <result property="star" column="star"/>
        <result property="memberIp" column="member_ip"/>
        <result property="createTime" column="create_time"/>
        <result property="showStatus" column="show_status"/>
        <result property="spuAttributes" column="spu_attributes"/>
        <result property="likesCount" column="likes_count"/>
        <result property="replyCount" column="reply_count"/>
        <result property="resources" column="resources"/>
        <result property="content" column="content"/>
        <result property="memberIcon" column="member_icon"/>
        <result property="commentType" column="comment_type"/>
    </resultMap>

    <!-- 删除会员自己的一条评价：member_id 写在 WHERE 里，归属校验与删除是同一条 SQL，
         删别人的或删不存在的都只会影响 0 行；调用方按受影响行数抛 COMMENT_NOT_FOUND。
         comment_type = 0 挡住回复行：回复的 member_id 也是本人，少了这个条件这里就成了
         "删除我的回复"的入口，而那条链路还要清关系行、回退回复数，本方法不做这些 -->
    <delete id="deleteOwn">
        DELETE FROM pms_spu_comment
        WHERE id = #{id}
          AND member_id = #{memberId}
          AND comment_type = 0
    </delete>

    <!-- 点赞与取消点赞共用，评价与回复都可点：可见性条件写在 WHERE 里，
         读与写之间被后台下架的评论改不动，调用方按受影响行数抛 COMMENT_NOT_FOUND。
         GREATEST 兜住取消点赞把计数减成负数 -->
    <update id="updateLikesCount">
        UPDATE pms_spu_comment
        SET likes_count = GREATEST(COALESCE(likes_count, 0) + #{delta}, 0)
        WHERE id = #{id}
          AND comment_type IN (0, 1)
          AND show_status = 1
    </update>

    <update id="increaseReplyCount">
        UPDATE pms_spu_comment
        SET reply_count = COALESCE(reply_count, 0) + 1
        WHERE id = #{commentId}
    </update>

    <!-- 先按关系表找到这条评价下的回复，再删内容行；关系行必须先留着，它是定位回复的唯一线索 -->
    <delete id="deleteReplies">
        DELETE c
        FROM pms_spu_comment c
        INNER JOIN pms_comment_replay r ON r.reply_id = c.id
        WHERE r.comment_id = #{commentId}
    </delete>


</mapper>