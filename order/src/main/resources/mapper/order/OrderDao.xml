<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="order.dao.OrderDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="order.entity.OrderEntity" id="orderMap">
        <result property="id" column="id"/>
        <result property="memberId" column="member_id"/>
        <result property="orderSn" column="order_sn"/>
        <result property="couponId" column="coupon_id"/>
        <result property="createTime" column="create_time"/>
        <result property="memberUsername" column="member_username"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="payAmount" column="pay_amount"/>
        <result property="freightAmount" column="freight_amount"/>
        <result property="promotionAmount" column="promotion_amount"/>
        <result property="integrationAmount" column="integration_amount"/>
        <result property="couponAmount" column="coupon_amount"/>
        <result property="discountAmount" column="discount_amount"/>
        <result property="payType" column="pay_type"/>
        <result property="sourceType" column="source_type"/>
        <result property="status" column="status"/>
        <result property="deliveryCompany" column="delivery_company"/>
        <result property="deliverySn" column="delivery_sn"/>
        <result property="autoConfirmDay" column="auto_confirm_day"/>
        <result property="integration" column="integration"/>
        <result property="growth" column="growth"/>
        <result property="billType" column="bill_type"/>
        <result property="billHeader" column="bill_header"/>
        <result property="billContent" column="bill_content"/>
        <result property="billReceiverPhone" column="bill_receiver_phone"/>
        <result property="billReceiverEmail" column="bill_receiver_email"/>
        <result property="receiverName" column="receiver_name"/>
        <result property="receiverPhone" column="receiver_phone"/>
        <result property="receiverPostCode" column="receiver_post_code"/>
        <result property="receiverProvince" column="receiver_province"/>
        <result property="receiverCity" column="receiver_city"/>
        <result property="receiverRegion" column="receiver_region"/>
        <result property="receiverDetailAddress" column="receiver_detail_address"/>
        <result property="note" column="note"/>
        <result property="confirmStatus" column="confirm_status"/>
        <result property="deleteStatus" column="delete_status"/>
        <result property="useIntegration" column="use_integration"/>
        <result property="paymentTime" column="payment_time"/>
        <result property="deliveryTime" column="delivery_time"/>
        <result property="receiveTime" column="receive_time"/>
        <result property="commentTime" column="comment_time"/>
        <result property="modifyTime" column="modify_time"/>
    </resultMap>
    <!-- 支付：待付款 0 -> 已付款 1，两个状态都固化在语句里（取值见 order.enums.OrderStatusEnum）。
         带 status = 0 条件，判断与写入是同一条 SQL：重复回调、或已被关单的订单都只会更新 0 行，
         不会把已取消的单改回已付款 -->
    <update id="updateOrderStatus">
        UPDATE oms_order
        SET `status` = #{code},modify_time = NOW(),pay_type = #{payType},payment_time = NOW()
        WHERE order_sn = #{orderSn}
          AND `status` = 0
    </update>

    <!-- 发货：1 已付款 -> 2 已发货，两个状态都固化在语句里（取值见 order.enums.OrderStatusEnum）。
         带 status = 1 条件，判断与写入是同一条 SQL，并发点两次发货只有一个会成功。
         刻意不动 pay_type 与 payment_time：那条语句只服务于支付流转，拿来做发货会把
         发货时间写成付款时间、并覆盖真实的支付方式 -->
    <update id="deliverOrder">
        UPDATE oms_order
        SET `status` = 2,
            delivery_company = #{deliveryCompany},
            delivery_sn = #{deliverySn},
            delivery_time = NOW(),
            modify_time = NOW()
        WHERE order_sn = #{orderSn}
          AND `status` = 1
    </update>

    <!-- 关单：待付款 0 -> 已取消 4，两个状态都固化在语句里（取值见 order.enums.OrderStatusEnum）。
         带 status = 0 条件，判断与写入是同一条 SQL：与支付回调并发时谁先到谁赢，
         订单被支付成功后再关单只会更新 0 行，不会把已付款的单改成已取消 -->
    <update id="closeOrder">
        UPDATE oms_order
        SET `status` = 4,modify_time = NOW()
        WHERE order_sn = #{orderSn}
          AND `status` = 0
    </update>

    <!-- 确认收货：已发货 2 -> 已完成 3，两个状态都固化在语句里（取值见 order.enums.OrderStatusEnum）。
         带 status = 2 条件，判断与写入是同一条 SQL：会员手动确认与任务自动确认并发时只有一个会成功 -->
    <update id="confirmReceive">
        UPDATE oms_order
        SET `status` = 3,
            confirm_status = 1,
            receive_time = NOW(),
            modify_time = NOW()
        WHERE order_sn = #{orderSn}
          AND `status` = 2
    </update>

    <!-- 改备注：只写 note 与 modify_time，不带状态条件 —— 备注是给运营看的说明，不参与状态流转，
         任何状态的订单都能改 -->
    <update id="updateNote">
        UPDATE oms_order
        SET note = #{note},modify_time = NOW()
        WHERE order_sn = #{orderSn}
    </update>

    <!-- 会员删除自己的订单：只置 delete_status = 1，订单及其订单项、支付流水都不动。
         member_id、状态、delete_status = 0 三个条件都写在 WHERE 里：归属校验、状态校验与"未删除"
         校验跟写入是同一条 SQL，越权、状态不允许、重复删除都只会更新 0 行。
         只放开 3 已完成与 4 已取消（取值见 order.enums.OrderStatusEnum）：进行中的订单还要走支付、
         发货与售后，从会员视图里消失会让会员找不到入口 -->
    <update id="markDeleted">
        UPDATE oms_order
        SET delete_status = 1,modify_time = NOW()
        WHERE order_sn = #{orderSn}
          AND member_id = #{memberId}
          AND `status` IN (3, 4)
          AND delete_status = 0
    </update>

    <!-- 后台硬删订单：只删被会员标记过的单（delete_status = 1）。准入条件写在 WHERE 里而不是只在
         服务层判断：物理删除不可逆，判断与写入必须是同一条 SQL。订单项、支付流水与库存工作单
         由服务层级联清理 -->
    <delete id="deleteMarked">
        DELETE FROM oms_order
        WHERE order_sn = #{orderSn}
          AND delete_status = 1
    </delete>

    <!-- 自动确认任务扫描到期订单：期限 = 发货时间 + auto_confirm_day 天，比较全在库里做（DB 跑 UTC）。
         auto_confirm_day 为空的行不会被选出 —— 秒杀单在补齐这两个字段之前建出的行就是空的 -->
    <select id="selectAutoConfirmable" resultType="java.lang.String">
        SELECT order_sn
        FROM oms_order
        WHERE `status` = 2
          AND auto_confirm_day IS NOT NULL
          AND delivery_time &lt;= DATE_SUB(NOW(), INTERVAL auto_confirm_day DAY)
        ORDER BY delivery_time
        LIMIT #{limit}
    </select>

    <!-- 评价后登记评价时间：带 member_id、status = 3 已完成（取值见 order.enums.OrderStatusEnum）与
         comment_time IS NULL 三个条件，归属校验、"已完成才能评"与幂等都写在 WHERE 里，
         越权、状态不符、重复登记都只会更新 0 行。
         刻意不动 status：评价不是状态流转，评价行落在 product 的 pms_spu_comment 里，
         这里只补订单自己的展示时间列 -->
    <update id="markCommented">
        UPDATE oms_order
        SET comment_time = NOW(),
            modify_time = NOW()
        WHERE order_sn = #{orderSn}
          AND member_id = #{memberId}
          AND `status` = 3
          AND comment_time IS NULL
    </update>

    <!-- 撤回评价时间：会员删掉自己的评价后调用。带 member_id 与 status = 3 已完成
         （取值见 order.enums.OrderStatusEnum）两个条件，归属与状态校验跟写入是同一条 SQL。
         与登记那条的区别是不要求 comment_time 非空：撤回本身就是把值清掉，
         值本来已经是 NULL 时不算改动，因此重复调用只更新 0 行、也不会重复写操作史 -->
    <update id="unmarkCommented">
        UPDATE oms_order
        SET comment_time = NULL,
            modify_time = NOW()
        WHERE order_sn = #{orderSn}
          AND member_id = #{memberId}
          AND `status` = 3
    </update>
    <!-- 售后前锁订单行：同一张订单的售后申请串行执行，整单退款前也用它把订单状态冻住，
         免得"钱已经退出去、作废语句却改 0 行"。只锁行、不改数据；
         用 orderMap 带出整行，调用方要按锁住那一刻的状态判断，不能拿锁之前的旧快照 -->
    <select id="lockOrderForAfterSale" resultMap="orderMap">
        SELECT *
        FROM oms_order
        WHERE order_sn = #{orderSn}
        FOR UPDATE
    </select>

    <!-- 整单退款成功后的订单作废：已付款 1 -> 已取消 4。
         与关单那条只差前置状态：关单从"待付款(0)"来，这条从"已付款(1)"来，
         分开写才能一眼看出各自允许的状态来源 -->
    <update id="refundCloseOrder">
        UPDATE oms_order
        SET `status` = 4,modify_time = NOW()
        WHERE order_sn = #{orderSn}
          AND `status` = 1
    </update>


</mapper>